{
  "name": "support-pack-builder",
  "version": "0.1.0",
  "description": "个人支撑材料编排器：完全本地运行的支撑材料 PDF 编排与导出工具",
  "type": "module",
  "main": "./out/main/index.cjs",
  "author": "SupportPack Builder Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "smoke:prepare": "tsx scripts/prepare-package-smoke.ts",
    "smoke:verify": "node scripts/verify-packaged-smoke.mjs",
    "icons": "tsx scripts/generate-icons.ts",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@napi-rs/canvas": "1.0.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@tanstack/react-virtual": "3.14.8",
    "antd": "6.5.2",
    "dayjs": "1.11.21",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "file-type": "22.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
